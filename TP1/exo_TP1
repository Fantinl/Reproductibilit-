from random import random
def main():
    equal_count = 0

    for _ in range(10000):
        x = random()
        y = random()
        z = random()
        if (x + y) + z == x + (y + z):
            equal_count += 1

    percentage = equal_count / 10000 * 100
    with open("answer_associativity.txt", "w", encoding="utf-8") as answer_file:
        answer_file.write(
            f"Equal: {equal_count}/{10000} ({percentage:.2f}%)\n"
        )

main()
